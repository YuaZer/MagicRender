{
  "schemaVersion": 1,
  "id": "magicrender",
  "version": "${version}",
  "name": "MagicRender",
  "description": "",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/magicrender/icon.png",
